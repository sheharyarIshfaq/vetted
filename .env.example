DATABASE_URL=postgres://tiko:tiko@localhost:5432/tiko

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tiko-uploads
S3_ACCESS_KEY_ID=tiko
S3_SECRET_ACCESS_KEY=tiko-secret
# MinIO needs path-style URLs
S3_FORCE_PATH_STYLE=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Daily model budget for checks, in dollars; past it, checks read the text only
OPENAI_DAILY_BUDGET_USD=20

# Contact address sent in the User-Agent when fetching official recall data
INGEST_CONTACT=
