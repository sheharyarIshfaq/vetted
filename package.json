{
  "name": "vetted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && cp -r drizzle .next/standalone/",
    "start": "node scripts/migrate.mjs && node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "check:openai": "tsx --env-file-if-exists=.env.local scripts/check-openai.ts",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "recalls:clean": "tsx --env-file-if-exists=.env.local scripts/clean-recalls.ts",
    "recalls:embed": "tsx --env-file-if-exists=.env.local scripts/embed-recalls.ts",
    "selftest": "tsx --env-file-if-exists=.env.local scripts/selftest.ts",
    "bench": "tsx --env-file-if-exists=.env.local scripts/bench.ts",
    "ext:build": "pnpm --dir extension build && node scripts/zip-extension.mjs",
    "ext:dev": "VETTED_API_BASE_URL=http://localhost:3123 pnpm --dir extension dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.15.0"
}
